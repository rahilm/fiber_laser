{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/rahilm/fiber_laser/blob/main/docs/dev/plugin-index.schema.json",
 "title": "mlaser plugin repository index (PLUGIN_STANDARD.md section 6)",
 "type": "object",
 "required": ["format", "version", "plugins"],
 "properties": {
  "format": {"const": "mlaser-plugin-index"},
  "version": {"const": 1},
  "name": {"type": "string", "maxLength": 200},
  "homepage": {"type": "string", "maxLength": 2000},
  "plugins": {
   "type": "array",
   "maxItems": 1000,
   "items": {"$ref": "#/$defs/plugin"}
  }
 },
 "$defs": {
  "plugin": {
   "type": "object",
   "required": ["id", "versions"],
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$"},
    "name": {"type": "string", "maxLength": 80},
    "summary": {"type": "string", "maxLength": 200},
    "description": {"type": "string", "maxLength": 20000},
    "homepage": {"type": "string", "pattern": "^https?://"},
    "source": {"type": "string", "pattern": "^https?://"},
    "authors": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 200}},
    "license": {"type": "string", "maxLength": 100},
    "versions": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/version"}}
   }
  },
  "version": {
   "type": "object",
   "required": ["version", "url", "sha256"],
   "properties": {
    "version": {"type": "string", "maxLength": 128, "description": "PEP 440 version = the wheel's version"},
    "url": {"type": "string", "maxLength": 4000, "pattern": "\\.whl([?#].*)?$",
            "description": "absolute https URL, or relative to the index URL"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "integer", "minimum": 0, "maximum": 100000000},
    "api": {"type": "string", "maxLength": 512, "description": "PEP 440 specifier against the plugin API"},
    "mlaser": {"type": "string", "maxLength": 512, "description": "PEP 440 specifier against the application"},
    "entry": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*(:[A-Za-z_][A-Za-z0-9_.]*)?$"},
    "requires": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 1024}},
    "permissions": {"$ref": "#/$defs/permissions"},
    "published": {"type": "string", "maxLength": 40}
   }
  },
  "permissions": {
   "type": "object",
   "properties": {
    "network": {"type": "array", "maxItems": 64,
                "items": {"type": "string", "pattern": "^(\\*\\.)?[a-z0-9.:\\[\\]-]+$"}},
    "files": {"type": "boolean"},
    "document": {"type": "boolean"},
    "orders": {"type": "boolean"},
    "queue": {"type": "boolean"},
    "machine": {"type": "boolean"},
    "secrets": {"type": "boolean"}
   }
  }
 }
}
